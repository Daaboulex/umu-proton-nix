# Canonical .envrc -- Nix Packaging Standard. `use flake` via nix-direnv makes
# the dev shell's exports (incl. the .devshell/ state pins) reach every
# in-project entry point; run `direnv allow` once per clone to activate.
use flake
if [ -n "${DEVSHELL_TMP:-}" ]; then
  export TMPDIR="$DEVSHELL_TMP" TMP="$DEVSHELL_TMP" TEMP="$DEVSHELL_TMP" TEMPDIR="$DEVSHELL_TMP"
fi
